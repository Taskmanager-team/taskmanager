# true  -> MSW intercepte les appels, aucun backend necessaire
# false -> les appels partent vers le vrai backend
VITE_USE_MOCKS=true

# Base de l'API reelle. Laisser VIDE pour passer par le proxy Vite, qui evite
# les erreurs CORS (le backend n'a aucune politique CORS configuree).
# Ne la renseigner que pour taper une API distante en direct.
VITE_API_BASE_URL=

# Backend vise par le proxy Vite quand VITE_USE_MOCKS=false.
# `dotnet run` -> http://localhost:5152 (defaut) / image Docker -> http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:5152
