# true  -> MSW intercepte les appels, aucun backend necessaire
# false -> les appels partent vers le vrai backend
VITE_USE_MOCKS=true

# Base de l'API reelle. Laisser vide en mode mocks (appels relatifs /api/...).
# Exemple avec le backend .NET : VITE_API_BASE_URL=https://localhost:7001
VITE_API_BASE_URL=
